# InvisibleBench Environment Variables
# Copy this file to .env and fill in your API keys

# OpenRouter provides the model catalog and the default API backend.
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: use the OpenAI API for model requests.
# Use OpenAI model IDs with this backend.
# OPENAI_API_KEY=your_openai_key_here
# INVISIBLEBENCH_API_BACKEND=openai
