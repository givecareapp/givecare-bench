{
  "schema_version": "hound.driver.v1",
  "id": "gc-bench",
  "protocol": "hound.protocol.v1",
  "owner": {
    "repo": "."
  },
  "exec": [
    ".venv/bin/python",
    "-B",
    "scripts/evidence_driver.py"
  ],
  "run_root": ".evidence/runs",
  "write_scopes": [
    "benchmark/scenarios",
    "data/releases/web-bench-release.tar.gz",
    "data/leaderboard/leaderboard.json"
  ],
  "ignored_snapshot_excludes": [
    ".evidence",
    ".pytest_cache",
    ".ruff_cache",
    ".venv",
    ".claude",
    ".codex",
    "internal",
    "adapters",
    "runs",
    "site"
  ],
  "timeouts_seconds": {
    "default": 60
  },
  "env_allowlist": [],
  "capabilities": {
    "corpus.apply": {
      "effect": "write",
      "gate": "human"
    },
    "corpus.project": {
      "effect": "write",
      "gate": "none"
    }
  }
}
