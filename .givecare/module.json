{
  "schema_version": "givecare.module/v2",
  "repository": "gc-bench",
  "owns": "InvisibleBench: checks, scenarios, the scan engine, and the leaderboard",
  "check": "scripts/check.sh",
  "produces": [
    {"id": "gc-bench.web-benchmark-release/v4", "path": "data/releases/web-bench-release.tar.gz", "for": ["gc-web"]},
    {"id": "gc-bench.run-record/v1", "path": "results", "for": ["gc-research"]}
  ],
  "consumes": [
    {"id": "gc-evals.gold-case/v1", "from": "gc-evals", "pin": "data/imports/evals/materialization.json"},
    {"id": "givecare.protocol", "from": "."}
  ]
}
