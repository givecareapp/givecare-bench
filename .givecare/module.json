{
  "schema_version": "givecare.module/v1",
  "repository": "gc-bench",
  "modules": [
    {
      "id": "bench.measure",
      "authority": {
        "kind": "git",
        "ref": "benchmark/benchmark_inventory.json"
      },
      "truth": [
        {
          "kind": "checks",
          "ref": "checks/"
        },
        {
          "kind": "scenarios",
          "ref": "benchmark/scenarios/"
        },
        {
          "kind": "scoring-contract",
          "ref": "benchmark/configs/scoring.yaml"
        }
      ],
      "verifiers": [
        "uv run ruff check .",
        "uv run pytest benchmark/tests -q",
        "uv run python scripts/lint_turn_indices.py --strict"
      ],
      "capabilities": [
        {
          "name": "benchmark.transcripts.plan",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "cli",
            "ref": "uv run bench --full --dry-run"
          },
          "accepts": [],
          "emits": []
        },
        {
          "name": "benchmark.transcripts.generate",
          "effect": "external",
          "gate": "none",
          "adapter": {
            "kind": "cli",
            "ref": "uv run bench --full -y --max-cost-usd <budget>"
          },
          "accepts": [
            "invisiblebench.scenario/safety-care-v2"
          ],
          "emits": [
            "invisiblebench-run-manifest/v2",
            "transcript_result/v1"
          ]
        },
        {
          "name": "benchmark.scan.plan",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "cli",
            "ref": "uv run python scripts/run_scan.py <run> --dry-run --llm-model <judge>"
          },
          "accepts": [
            "invisiblebench-run-manifest/v2"
          ],
          "emits": [
            "invisiblebench-scan-plan/v3"
          ]
        },
        {
          "name": "benchmark.scan",
          "effect": "external",
          "gate": "none",
          "adapter": {
            "kind": "cli",
            "ref": "uv run python scripts/run_scan.py <run> --plan <scan-dir>/scan_plan.json --max-cost-usd <budget> --llm-model <judge>"
          },
          "accepts": [
            "invisiblebench-run-manifest/v2",
            "invisiblebench-scan-plan/v3"
          ],
          "emits": [
            "invisiblebench-scanned-row/4.0.0",
            "invisiblebench-scan-checkpoint/v2"
          ]
        },
        {
          "name": "benchmark.inspect",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "cli",
            "ref": "uv run bench explain <model> <scenario> --failures"
          },
          "accepts": [
            "invisiblebench-scanned-row/4.0.0"
          ],
          "emits": []
        },
        {
          "name": "benchmark.evals.projection.sync",
          "effect": "write",
          "gate": "none",
          "adapter": {
            "kind": "owner-projection-sync",
            "ref": "scripts/sync_evals_projection.py"
          },
          "accepts": [
            "givecare.artifact-ref/v1"
          ],
          "emits": [
            "gc-bench.evals-materialization/v2"
          ]
        },
        {
          "name": "benchmark.scenarios.apply",
          "effect": "write",
          "gate": "human",
          "adapter": {
            "kind": "evidence-operation",
            "ref": "evidence-driver.json#corpus.apply"
          },
          "accepts": [
            "gc-bench.candidate-intake.input/v2"
          ],
          "emits": [
            "gc-bench.candidate-intake.result/v1",
            "invisiblebench.candidate-scenario/v1"
          ]
        }
      ]
    },
    {
      "id": "bench.publish",
      "authority": {
        "kind": "git",
        "ref": "data/leaderboard/leaderboard.json"
      },
      "truth": [
        {
          "kind": "leaderboard",
          "ref": "data/leaderboard/leaderboard.json"
        },
        {
          "kind": "projection",
          "ref": "data/releases/web-bench-release.tar.gz"
        },
        {
          "kind": "evidence-driver",
          "ref": "evidence-driver.json"
        }
      ],
      "verifiers": [
        "uv run pytest benchmark/tests -q",
        "helm evidence driver check --driver evidence-driver.json"
      ],
      "capabilities": [
        {
          "name": "benchmark.leaderboard.read",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "file",
            "ref": "data/leaderboard/leaderboard.json"
          },
          "accepts": [],
          "emits": [
            "safety-care/v2"
          ]
        },
        {
          "name": "benchmark.web-release.read",
          "effect": "read",
          "gate": "none",
          "adapter": {
            "kind": "file",
            "ref": "data/releases/web-bench-release.tar.gz"
          },
          "accepts": [
            "gc-bench.web-benchmark-release/v2"
          ],
          "emits": [
            "safety-care/v2"
          ]
        },
        {
          "name": "benchmark.web-release.project",
          "effect": "write",
          "gate": "none",
          "adapter": {
            "kind": "evidence-operation",
            "ref": "evidence-driver.json#corpus.project"
          },
          "accepts": [
            "gc-bench.web-benchmark-release.input/v2"
          ],
          "emits": [
            "safety-care/v2",
            "gc-bench.web-benchmark-release/v2",
            "givecare.artifact-ref/v1"
          ]
        }
      ]
    }
  ]
}
